# Local development defaults for compose.yaml and backend local profile.
# Copy to .env if you need overrides. Do not commit a real .env file.

POSTGRES_DB=antar
POSTGRES_USER=antar
POSTGRES_PASSWORD=antar
POSTGRES_PORT=5432

REDIS_PORT=6379

# If host port 5432 is already in use on your machine, override:
# POSTGRES_PORT=5435

# Mobile API base URL examples (set as EXPO_PUBLIC_API_BASE_URL):
# iOS simulator:     http://localhost:8080
# Android emulator:  http://10.0.2.2:8080
# Physical device:   http://<your-lan-ip>:8080
