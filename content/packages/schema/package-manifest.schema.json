{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antar.local/schemas/content-package/package-manifest.schema.json",
  "title": "Antar Scripture Package Manifest",
  "description": "Root metadata for an immutable Scripture content package (format version 1).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packageId",
    "scriptureId",
    "chapterNumber",
    "contentVersion",
    "recordCount",
    "canonicalReferenceRange",
    "createdAt",
    "packageStatus",
    "sourceRegistryReferences",
    "editorialApprovalManifestChecksum",
    "packageFormatVersion",
    "checksumAlgorithm",
    "packageChecksum",
    "fileChecksums",
    "allowNullTransliteration"
  ],
  "properties": {
    "packageId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "scriptureId": {
      "type": "string",
      "minLength": 1
    },
    "chapterNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18
    },
    "contentVersion": {
      "type": "integer",
      "minimum": 1
    },
    "recordCount": {
      "type": "integer",
      "minimum": 1
    },
    "canonicalReferenceRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "expectedCount"],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[1-9][0-9]*\\.[1-9][0-9]*$"
        },
        "to": {
          "type": "string",
          "pattern": "^[1-9][0-9]*\\.[1-9][0-9]*$"
        },
        "expectedCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "packageStatus": {
      "type": "string",
      "enum": ["DRAFT", "APPROVED", "SUPERSEDED", "REVOKED"]
    },
    "sourceRegistryReferences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "editorialApprovalManifestChecksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "packageFormatVersion": {
      "type": "integer",
      "const": 1
    },
    "checksumAlgorithm": {
      "type": "string",
      "const": "SHA-256"
    },
    "packageChecksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of verses.jsonl bytes concatenated with provenance.json bytes, in that order."
    },
    "fileChecksums": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verses.jsonl", "provenance.json"],
      "properties": {
        "verses.jsonl": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "provenance.json": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "allowNullTransliteration": {
      "type": "boolean",
      "description": "When true, verse transliteration may be null. When false, every verse must include nonblank transliteration."
    }
  }
}
