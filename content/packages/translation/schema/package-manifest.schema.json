{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antar.local/schemas/translation-package/package-manifest.schema.json",
  "title": "Antar Translation Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packageId",
    "scriptureId",
    "chapterNumber",
    "language",
    "provider",
    "sourceName",
    "licenseType",
    "contentVersion",
    "recordCount",
    "canonicalReferenceRange",
    "createdAt",
    "packageStatus",
    "sourceRegistryReferences",
    "editorialApprovalManifestChecksum",
    "packageFormatVersion",
    "checksumAlgorithm",
    "packageChecksum",
    "fileChecksums"
  ],
  "properties": {
    "packageId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "scriptureId": {
      "type": "string",
      "minLength": 1
    },
    "chapterNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "sourceName": {
      "type": "string",
      "minLength": 1
    },
    "licenseType": {
      "type": "string",
      "minLength": 1
    },
    "licenseReference": {
      "type": [
        "string",
        "null"
      ]
    },
    "contentVersion": {
      "type": "integer",
      "minimum": 1
    },
    "recordCount": {
      "type": "integer",
      "minimum": 1
    },
    "canonicalReferenceRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "expectedCount"
      ],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[1-9][0-9]*\\.[1-9][0-9]*$"
        },
        "to": {
          "type": "string",
          "pattern": "^[1-9][0-9]*\\.[1-9][0-9]*$"
        },
        "expectedCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "packageStatus": {
      "type": "string",
      "enum": [
        "DRAFT",
        "APPROVED",
        "SUPERSEDED",
        "REVOKED"
      ]
    },
    "sourceRegistryReferences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "editorialApprovalManifestChecksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "packageFormatVersion": {
      "type": "integer",
      "const": 1
    },
    "checksumAlgorithm": {
      "type": "string",
      "const": "SHA-256"
    },
    "packageChecksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fileChecksums": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "translations.jsonl",
        "provenance.json"
      ],
      "properties": {
        "translations.jsonl": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "provenance.json": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
