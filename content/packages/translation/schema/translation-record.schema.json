{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antar.local/schemas/translation-package/translation-record.schema.json",
  "title": "Antar Translation Package Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "canonicalReference",
    "chapterNumber",
    "verseNumber",
    "translationText",
    "contentVersion",
    "sourceIds",
    "sourceChecksums",
    "editorialDecisionId",
    "editorialApprovalChecksum"
  ],
  "properties": {
    "canonicalReference": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[1-9][0-9]*$"
    },
    "chapterNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18
    },
    "verseNumber": {
      "type": "integer",
      "minimum": 1
    },
    "translationText": {
      "type": "string",
      "minLength": 1
    },
    "contentVersion": {
      "type": "integer",
      "minimum": 1
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceChecksums": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "editorialDecisionId": {
      "type": "string",
      "minLength": 1
    },
    "editorialApprovalChecksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
